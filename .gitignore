.claude/worktrees/
node_modules/
dist/
dist-single/
dist-atlas/
tower-tycoon.html
*.log
.DS_Store
coverage/
*.js.map
*.d.ts
# The WASM binding's declaration, generated by wasm:build and checked in.
!src/dualrun/engine.d.ts
*.js
!dist/*.js
# The served engine package's loader (wasm:build writes it; see
# src/wasmhost/packageHash.test.ts for the freshness guard).
!src/public/engine/*.js
!eslint.config.js
!vite.config.ts
!vite-env.d.ts
__pycache__/
node_modules

# Local env files (Vite overrides; `vercel dev` pulls development secrets here)
.env.local
.env.*.local

# Vercel CLI project link and local config
.vercel

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
# E2E capture output (milestones.spec.ts): per-run artifacts, uploaded by CI,
# never committed (the committed docs/screenshots gallery comes only from the
# pinned-container pipeline).
/e2e/output/

# Nondeterminism evidence from scripts/screenshot-determinism-check.ts
determinism-diff/

# Rust engine build output
engine-rs/target/
engine-rs/pkg/
