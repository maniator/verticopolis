{
  "id": "express-basements-classic",
  "description": "The Classic tower-one at four stars builds an express shaft from B4 up into the tower: it stops at every basement floor it passes and, above ground, only at the lobbies. A basement stop is turned off, survives a save round trip, and is turned back on; the shaft is then shortened to B2 and extended back down to B6, stopping at each basement it now passes, and a last round trip keeps it all.",
  "start": { "fixture": "conformance/fixtures/towerone-star4.vctower" },
  "commands": [
    { "op": "buildTransport", "kind": "elevatorExpress", "x": 169, "bottom": -3, "top": 15 },
    { "op": "setCars", "floor": 1, "x": 169, "cars": 2 },
    { "op": "checkpoint", "label": "built" },
    { "op": "setStop", "floor": 1, "x": 169, "stopFloor": -1, "stop": false },
    { "op": "tick", "dt": 30, "times": 48, "checkpointEvery": 24 },
    { "op": "reload" },
    { "op": "checkpoint", "label": "b2-off-reloaded" },
    { "op": "setStop", "floor": 1, "x": 169, "stopFloor": -1, "stop": true },
    { "op": "resizeTransport", "floor": 1, "x": 169, "bottom": -1, "top": 15 },
    { "op": "resizeTransport", "floor": 1, "x": 169, "bottom": -5, "top": 15 },
    { "op": "checkpoint", "label": "extended-down" },
    { "op": "tick", "dt": 30, "times": 48, "checkpointEvery": 24 },
    { "op": "reload" },
    { "op": "checkpoint", "label": "extended-reloaded" }
  ]
}
