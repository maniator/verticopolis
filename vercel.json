{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "bash scripts/vercel-install.sh",
  "devCommand": "npm run dev -- --port $PORT --strictPort",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "main": false } },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?:help/)?_astro/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?:help/)?pagefind/(?:fragment|index)/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" },
      "continue": true
    },
    {
      "src": "^/version\\.json$",
      "headers": { "Cache-Control": "no-store" },
      "continue": true
    },
    {
      "src": "^/gallery/?$",
      "has": [{ "type": "host", "value": "verticopolis.com" }],
      "status": 308,
      "headers": { "Location": "https://help.verticopolis.com/rooms/" }
    },
    { "src": "^/gallery/?$", "status": 308, "headers": { "Location": "/help/rooms/" } },
    {
      "src": "^/help(?:/|$)(.*)$",
      "has": [{ "type": "host", "value": "verticopolis.com" }],
      "status": 308,
      "headers": { "Location": "https://help.verticopolis.com/$1" }
    },
    {
      "src": "^/help(?:/|$)(.*)$",
      "has": [{ "type": "host", "value": "help.verticopolis.com" }],
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "^/(?!api/|_vercel/|assets/|styles/)(.*)$",
      "has": [{ "type": "host", "value": "help.verticopolis.com" }],
      "dest": "/help/$1",
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
