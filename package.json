{
  "name": "verticopolis",
  "version": "2.7.0",
  "description": "Verticopolis: a browser-native SimTower clone in TypeScript",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "npm run verify:dist && node scripts/verify-wrapper-seam.ts browser",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p api/tsconfig.json",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @perf",
    "perf": "playwright test --grep @perf",
    "perf:capture": "PERF_CAPTURE=1 playwright test --grep @perf",
    "lint": "eslint src api --ext .ts,.tsx",
    "lint:fix": "eslint src api --ext .ts,.tsx --fix",
    "screenshots": "vite build && RUN_SERVER=1 node scripts/screenshots.ts",
    "icons": "node scripts/gen-pwa-icons.mjs",
    "og-image": "node scripts/gen-og-image.mjs",
    "build:desktop": "vite build --mode desktop && npm run verify:dist && node scripts/verify-wrapper-seam.ts desktop",
    "verify:dist": "node scripts/prerender-help.ts && node scripts/verify-precache.ts && node scripts/verify-game-handle.ts",
    "build:native": "vite build --mode native && npm run verify:dist && node scripts/verify-wrapper-seam.ts native"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.10.6",
    "marked": "^18.0.6",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "excalibur": "^0.32.0",
    "fflate": "^0.8.3",
    "lit-html": "^3.3.3",
    "tone": "^15.1.22"
  }
}
