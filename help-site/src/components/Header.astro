---
// Starlight's own header (title, search, theme switch) with the game's "Back
// to game" button at its right, so it shows on every page and every screen
// size. A tab the game opened (?from=game, src/ui/fromGame.ts) closes on Back
// to game instead of loading a second copy of the game; the note below says
// so when the browser keeps the tab open.
import Default from "@astrojs/starlight/components/Header.astro";
---

<div class="vc-header">
  <div class="vc-header-default"><Default /></div>
  <a class="vc-back" href="/" data-act="back-to-game">Back to game</a>
</div>
<p id="back-note" class="vc-back-note" tabindex="-1" hidden></p>

<script>
  import { backToOpenGame, takeFromGameFlag } from "../../../src/ui/fromGame";
  import { injectVercelTelemetry } from "../../../src/telemetry";
  import { trackAppAction } from "../../../src/analytics";

  injectVercelTelemetry();
  trackAppAction("page_help");
  if (takeFromGameFlag(location, history)) {
    for (const back of document.querySelectorAll<HTMLAnchorElement>('a[data-act="back-to-game"]')) {
      back.addEventListener("click", (e) => backToOpenGame(e));
    }
  }
</script>
