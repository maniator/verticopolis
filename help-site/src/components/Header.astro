---
// The help site's header: the game's menu bar on top (MenuBar.astro), then
// the title bar (TitleBar.astro, the same bar the engine docs draw), handed this site's own Starlight search and theme switch, with its
// game button pointed at the game (verticopolis.com from the manual's own
// host, this same host in a /help build). In a
// tab the game opened (?from=game, src/ui/fromGame.ts) that button and the
// front page's Play button both read Back to game and close this tab instead
// of loading a second copy of the game; the note below says so when the
// browser keeps the tab open. In an installed app the manual on its own host
// opens in a browser view over the app, so the button closes that view; a
// /help build in the app's own window first checks the game still runs, and
// loads it here when it doesn't (backToOpenGame).
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import TitleBar from "./TitleBar.astro";
import MenuBar from "./MenuBar.astro";
import HelpBar from "./HelpBar.astro";
import logo from "../assets/logo.png";
import { siteHref } from "../../site.mjs";
---

<MenuBar />
<TitleBar logo={logo} short="Help" game={siteHref("/")}>
  <Search slot="search" />
  <ThemeSelect slot="theme" />
</TitleBar>
<p id="back-note" class="vc-back-note" tabindex="-1" hidden></p>
<HelpBar />

<script>
  import { backToOpenGame, helpVisitSource, repeatsEarlierLoad, takeFromGameFlag } from "../../../src/ui/fromGame";
  import { injectPageTelemetry } from "../../../src/telemetry";
  import { getCommonProps, setCommonProps, trackAppAction } from "../../../src/analytics";
  import { gameLinkDetail, helpPageDetail, landingAction, sponsorTapListener } from "../../site.mjs";
  import { saveManualOffline } from "../../../src/manual/manualOffline";
  import {
    EMBEDDED_CLASS,
    embeddedClick,
    gameOriginFor,
    pageMessage,
    readManualCommand,
    type ManualLook,
  } from "../../../src/manual/manualEmbed";
  import { openStarlightSearch } from "../../../src/ui/starlightSearch";

  // The site's base as Astro built it: "" at the root of the manual's own
  // host, "/help" on the game's.
  const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
  injectPageTelemetry();
  // The appearance scheme the page wears (site.mjs schemeBootScript set it
  // before paint), on every event here as in the game.
  setCommonProps({ ...getCommonProps(), scheme: document.documentElement.getAttribute("data-scheme") ?? "standard" });
  // A landing names where the visit started (#2037): the place in the game
  // that opened it, read from its ?from=game&via= marks before
  // takeFromGameFlag clears them (a reload reads them back from this tab), or
  // direct. A fixed code, never an address.
  const source = helpVisitSource(location.search, repeatsEarlierLoad());
  const landing = landingAction(location.pathname, document.referrer, location.origin, base);
  if (landing) trackAppAction(landing, source);
  // Every page view, landing or not, names its page, so the help pages
  // people read show up in PostHog and not only where they arrived.
  trackAppAction("help_page_view", helpPageDetail(location.pathname, base));
  // Save the whole manual for offline reading (src/manual/manualOffline.ts),
  // counting the first save on this device once.
  void saveManualOffline(base, {
    workers: window.isSecureContext && "serviceWorker" in navigator ? navigator.serviceWorker : null,
    doc: document,
    host: location.host,
    track: () => trackAppAction("help_offline_saved"),
  });
  // A tap on any link to the Sponsors page counts once as sponsor_click
  // (help-site/site.mjs sponsorTapListener); the link itself opens as before.
  const noteSponsorTap = sponsorTapListener(() => trackAppAction("sponsor_click", "help"));
  document.addEventListener("click", noteSponsorTap);
  document.addEventListener("auxclick", noteSponsorTap);
  const fromGame = takeFromGameFlag(location, history);
  // Inside the game's Help window (src/manual/manualEmbed.ts), once the
  // game's marks are off the address: tell the game each page shown, for its
  // title bar and its Back and Forward; follow the manual's own links with
  // location.replace so the game's history never fills with manual pages,
  // and open links out of the manual in a browser tab. F1 does nothing here:
  // the manual is already open, and the browser's own help would cover it.
  if (document.documentElement.classList.contains(EMBEDDED_CLASS)) {
    const game = gameOriginFor(location.host, location.origin);
    const looks = () => document.querySelector<HTMLSelectElement>("starlight-theme-select select");
    const look = (): ManualLook => {
      const value = looks()?.value;
      return value === "light" || value === "dark" ? value : "auto";
    };
    const tell = () => window.parent.postMessage(pageMessage(location, base, document.title, look()), game);
    tell();
    window.addEventListener("hashchange", tell);
    // The window's menus: Print Topic, Find and the Options looks.
    window.addEventListener("message", (e) => {
      if (e.source !== window.parent || e.origin !== game) return;
      const command = readManualCommand(e.data);
      if (command?.command === "print") window.print();
      else if (command?.command === "find") openStarlightSearch();
      else if (command?.command === "look") {
        const select = looks();
        if (!select) return;
        select.value = command.look;
        select.dispatchEvent(new Event("change"));
        tell();
      }
    });
    document.addEventListener("click", (e) => {
      const link = e.target instanceof Element ? e.target.closest("a") : null;
      const to = embeddedClick(e, link, location.href, base);
      if (!to) return;
      e.preventDefault();
      if ("replace" in to) location.replace(to.replace);
      else window.open(to.open, "_blank", "noopener");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "F1") e.preventDefault();
    });
  }
  for (const play of document.querySelectorAll<HTMLAnchorElement>("a[data-game-link]")) {
    // Each press on the title bar's game button or the front page's Play
    // counts as help_game_link (site.mjs gameLinkDetail), before Back to
    // game closes the tab; the beacon still leaves.
    const detail = gameLinkDetail(!!play.closest(".title-screen"), fromGame);
    play.addEventListener("click", () => trackAppAction("help_game_link", detail));
    if (!fromGame) continue;
    // The game is already open in another tab. The bar writes its label
    // twice (the full one and a phone's short one), so each copy changes.
    const labels = play.querySelectorAll<HTMLElement>(".vc-full, .vc-short");
    if (labels.length === 0) play.textContent = "Back to game";
    for (const label of labels) label.textContent = "Back to game";
    play.addEventListener("click", (e) => backToOpenGame(e));
  }
</script>
