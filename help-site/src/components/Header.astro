---
// The help site's header: the shared title bar (docs/engine-site's
// TitleBar.astro, the same bar the engine docs and the Rust API reference
// draw), handed this site's own Starlight search and theme switch, with its
// game button pointed at the game on this same origin. In a
// tab the game opened (?from=game, src/ui/fromGame.ts) that button and the
// front page's Play button both read Back to game and close this tab instead
// of loading a second copy of the game; the note below says so when the
// browser keeps the tab open.
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import TitleBar from "../../../docs/engine-site/src/components/TitleBar.astro";
import logo from "../assets/logo.png";
---

<TitleBar logo={logo} short="Help" game="/">
  <Search slot="search" />
  <ThemeSelect slot="theme" />
</TitleBar>
<p id="back-note" class="vc-back-note" tabindex="-1" hidden></p>

<script>
  import { backToOpenGame, takeFromGameFlag } from "../../../src/ui/fromGame";
  import { injectVercelTelemetry } from "../../../src/telemetry";
  import { trackAppAction } from "../../../src/analytics";
  import { helpPageDetail, landingAction, sponsorTapListener } from "../../site.mjs";

  injectVercelTelemetry();
  const landing = landingAction(location.pathname, document.referrer, location.origin);
  if (landing) trackAppAction(landing);
  // Every page view, landing or not, names its page, so the help pages
  // people read show up in PostHog and not only where they arrived.
  trackAppAction("help_page_view", helpPageDetail(location.pathname));
  // A tap on any link to the Sponsors page counts once as sponsor_click
  // (help-site/site.mjs sponsorTapListener); the link itself opens as before.
  const noteSponsorTap = sponsorTapListener(() => trackAppAction("sponsor_click", "help"));
  document.addEventListener("click", noteSponsorTap);
  document.addEventListener("auxclick", noteSponsorTap);
  if (takeFromGameFlag(location, history)) {
    // The title bar's game button and the front page's Play button: the
    // game is already open in another tab. The bar writes its label twice
    // (the full one and a phone's short one), so each copy changes.
    for (const play of document.querySelectorAll<HTMLAnchorElement>("a[data-game-link]")) {
      const labels = play.querySelectorAll<HTMLElement>(".vc-full, .vc-short");
      if (labels.length === 0) play.textContent = "Back to game";
      for (const label of labels) label.textContent = "Back to game";
      play.addEventListener("click", (e) => backToOpenGame(e));
    }
  }
</script>
