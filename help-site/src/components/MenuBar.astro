---
// The game's Win95 menu bar across the top of every help page, above its title bar, so the manual
// looks like the game (owner, 2026-11-15). The components' MenuBar draws it
// into the host below from the model src/ui/helpSiteMenu.ts builds, which
// also says what each item does; each item's data-help-item is the code its
// pick reports. The host carries the addresses the links go to. The game item
// reads "Back to Game" in a tab the game opened, and "Play Verticopolis"
// elsewhere.
import { GITHUB_ISSUES, SPONSOR_URL, siteHref } from "../../site.mjs";
---

<div
  id="help-menubar-host"
  data-game={siteHref("/")}
  data-whats-new={siteHref("/help/changelog/")}
  data-report={GITHUB_ISSUES}
  data-sponsor={SPONSOR_URL}
>
</div>

<script>
  import { wireHelpMenu, type HelpTheme } from "../../../src/ui/helpSiteMenu";
  import { backToOpenGame, takeFromGameFlag } from "../../../src/ui/fromGame";
  import { openStarlightSearch } from "../../../src/ui/starlightSearch";
  import { trackAppAction } from "../../../src/analytics";

  const host = document.getElementById("help-menubar-host");
  if (host) {
    const themeSelect = () => document.querySelector<HTMLSelectElement>("starlight-theme-select select");
    const links = host.dataset;
    wireHelpMenu(host, {
      links: {
        game: links.game ?? "/",
        whatsNew: links.whatsNew ?? "",
        report: links.report ?? "",
        sponsor: links.sponsor ?? "",
      },
      // Header.astro has already taken ?from=game off the address; the flag
      // lives on in this tab's session storage, which this reads.
      fromGame: takeFromGameFlag(location, history),
      backToGame: (e) => backToOpenGame(e),
      print: () => window.print(),
      openSearch: () => openStarlightSearch(),
      copyLink: (url) => navigator.clipboard.writeText(url),
      pageUrl: () => location.origin + location.pathname,
      theme: () => {
        const value = themeSelect()?.value;
        return value === "light" || value === "dark" ? value : "auto";
      },
      setTheme: (theme: HelpTheme) => {
        const select = themeSelect();
        if (!select) return;
        select.value = theme;
        select.dispatchEvent(new Event("change"));
      },
      track: (item) => trackAppAction("help_menu_pick", item),
    });
  }
</script>
