{
  "name": "verticopolis-help",
  "private": true,
  "description": "The player help site at help.verticopolis.com, a Starlight site over the help pages the game also reads",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "node scripts/sync-assets.mjs && astro dev",
    "build": "node scripts/sync-assets.mjs && astro build",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.12"
  }
}
